{
  "name": "tokenshelf",
  "version": "1.0.0",
  "description": "Agent-focused CLI for discovering and working with Tokenshelf design systems",
  "homepage": "https://github.com/infomiho/tokenshelf#readme",
  "bugs": {
    "url": "https://github.com/infomiho/tokenshelf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infomiho/tokenshelf.git",
    "directory": "cli"
  },
  "bin": {
    "tokenshelf": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "fmt": "oxfmt src scripts tsdown.config.ts package.json tsconfig.json .oxfmtrc.json",
    "fmt:check": "oxfmt --check src scripts tsdown.config.ts package.json tsconfig.json .oxfmtrc.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ky": "^2.0.2",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.62.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
