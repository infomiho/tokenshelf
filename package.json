{
  "name": "tokenshelf",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt src main.wasp.ts package.json .oxfmtrc.json",
    "fmt:check": "oxfmt --check src main.wasp.ts package.json .oxfmtrc.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@infomiho/agent-work-protocol": "^0.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "date-fns": "^4.4.0",
    "helmet": "^6.0.0",
    "ipaddr.js": "^2.4.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "oxfmt": "^0.62.0",
    "playwright": "1.62.1",
    "prisma": "5.19.1",
    "storybook": "10.5.6",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
